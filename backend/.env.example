# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=agenticapi
MYSQL_USER=root

# 调试模式
DEBUG=True

# 服务配置
SERVER_HOST=127.0.0.1
SERVER_PORT=2027
# 对外公开访问地址（部署到公网时改为真实地址，如 https://api.example.com）
# 用途：模型拨测自调用、前端展示的中转接口地址（GET /site/info 下发）
PUBLIC_BASE_URL=http://localhost:2027

# 下面的配置是Agent能力的来源
AGENT_BASE_URL=https://api.stepfun.com/step_plan/v1/chat/completions
ASR_BASE_URL=https://api.stepfun.com/step_plan/v1/audio/asr/sse
STEPFUN_API_KEY=your-stepfun-api-key
AGENT_TITLE_MODEL=step-3.7-flash

# 智谱 GLM Coding Plan 用量监控（API key 长期有效，替代原浏览器 Authorization JWT）
ZAI_API_KEY=your-zai-coding-plan-api-key
ZAI_API_KEY_2=your-zai-coding-plan-api-key-2

# CommandCode TokenPlan 用量监控（x-api-key 鉴权，Bearer 会被上游拒绝）
COMMANDCODE_API_KEY=your-commandcode-tokenplan-api-key

# 维护 Agent 容器沙箱（v0.10.0，全部可选，不配走默认值）
# 沙箱总开关；镜像/基础镜像（Docker Hub 慢时可换国内源，如 docker.m.daocloud.io/library/python:3.12-slim）
# 服务器运行用户不在 docker 组时配 SANDBOX_DOCKER_CMD=sudo -n docker
#SANDBOX_ENABLED=True
#SANDBOX_DOCKER_CMD=docker
#SANDBOX_IMAGE=agenticapi-sandbox:latest
#SANDBOX_BASE_IMAGE=python:3.12-slim
# 镜像构建时的 pip 源（pypi.org 不可达的内网环境换国内镜像，如 https://mirrors.tencentyun.com/pypi/simple）
#SANDBOX_PIP_INDEX_URL=https://pypi.org/simple
#SANDBOX_IDLE_STOP_SECONDS=900
#SANDBOX_MAX_CONCURRENT=2
#SANDBOX_CMD_TIMEOUT_MAX=120
