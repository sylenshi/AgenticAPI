# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=agenticapi
MYSQL_USER=root

# 调试模式
DEBUG=True

# 服务配置
SERVER_HOST=127.0.0.1
SERVER_PORT=2027
# 对外公开访问地址（部署到公网时改为真实地址，如 https://api.example.com）
# 用途：模型拨测自调用、前端展示的中转接口地址（GET /site/info 下发）
PUBLIC_BASE_URL=http://localhost:2027

# 下面的配置是Agent能力的来源
AGENT_BASE_URL=https://api.stepfun.com/step_plan/v1/chat/completions
ASR_BASE_URL=https://api.stepfun.com/step_plan/v1/audio/asr/sse
STEPFUN_API_KEY=your-stepfun-api-key
AGENT_TITLE_MODEL=step-3.7-flash
# 站点维护 Agent 默认大脑模型（可选；解析链 system_config.agent_default_model → 此值 → 站内首个启用模型）
#AGENT_MAINTENANCE_MODEL=

# 智谱 GLM Coding Plan 用量监控（v2 套餐账号；控制台"运营-设置凭证"上传的 key 优先于此兜底值）
ZAI_API_KEY_2=your-zai-coding-plan-api-key

# Antigravity（Gemini PRO）限额监控：数据源为 sub2api 容器（订阅转 API 网关，8080）
# 同机部署默认值即可；本地开发需先开隧道：ssh -N -L 8080:127.0.0.1:8080 <ssh别名>
# 凭证为 sub2api 管理员账号（与 Web 后台同款），登录换 JWT 查 Gemini/Claude 双池限额
#ANTIGRAVITY_BASE_URL=http://127.0.0.1:8080
#ANTIGRAVITY_ADMIN_EMAIL=
#ANTIGRAVITY_ADMIN_PASSWORD=
# 查询的 sub2api 账号 ID（逗号分隔；多账号时各窗口取最大利用率保守展示）
#ANTIGRAVITY_ACCOUNT_IDS=1

# 维护 Agent 容器沙箱（v0.10.0，全部可选，不配走默认值）
# 沙箱总开关；镜像/基础镜像（Docker Hub 慢时可换国内源，如 docker.m.daocloud.io/library/python:3.12-slim）
# 服务器运行用户不在 docker 组时配 SANDBOX_DOCKER_CMD=sudo -n docker
#SANDBOX_ENABLED=True
#SANDBOX_DOCKER_CMD=docker
#SANDBOX_IMAGE=agenticapi-sandbox:latest
#SANDBOX_BASE_IMAGE=python:3.12-slim
# 镜像构建时的 pip 源（pypi.org 不可达的内网环境换国内镜像，如 https://mirrors.tencentyun.com/pypi/simple）
#SANDBOX_PIP_INDEX_URL=https://pypi.org/simple
# 镜像构建时的 Debian apt 源主机（deb.debian.org 海外下载慢时换国内源，如 mirrors.cloud.tencent.com）
#SANDBOX_APT_MIRROR=deb.debian.org
#SANDBOX_IDLE_STOP_SECONDS=900
#SANDBOX_MAX_CONCURRENT=2
#SANDBOX_CMD_TIMEOUT_MAX=120
# ── 沙箱-MySQL 桥接（v0.11.0：data-governance 技能在沙箱内跑 pymysql 脚本）──
# SANDBOX_MYSQL_HOST 留空 = 沙箱与数据库保持隔离（同 v0.10.0）；配置后向容器注入
# MYSQL_HOST/PORT/USER/PASSWORD/DATABASE 环境变量，三种取值：
#   host              经 host-gateway 访问宿主机端口（Docker Desktop 可达宿主回环服务，本地开发用）
#   container:<名称>  MySQL 为 Docker 容器时，把沙箱接入其所在网络、以容器名直连
#                     （服务器 MySQL 只绑宿主回环时用这种，先 docker ps 查容器名）
#   其他值            当作主机名/IP 直连（同时注入 host-gateway 解析）
# 连接凭证默认复用上面的 MYSQL_USER/MYSQL_PASSWORD/MYSQL_PORT/MYSQL_DATABASE，
# 也可用 SANDBOX_MYSQL_USER / SANDBOX_MYSQL_PASSWORD 覆盖（如为沙箱单独建最小权限账号）
#SANDBOX_MYSQL_HOST=
#SANDBOX_MYSQL_USER=
#SANDBOX_MYSQL_PASSWORD=
